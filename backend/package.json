{
  "name": "taskbox-backend",
  "version": "3.0.0",
  "description": "TaskBox API (application tier): Express + Prisma + Cloudinary, written in TypeScript",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "2.5.1",
    "cookie-parser": "^1.4.7",
    "express": "4.19.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "1.4.5-lts.1",
    "prisma": "5.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "1.4.12",
    "@types/node": "20.17.9",
    "typescript": "5.6.3"
  }
}

# Copy to .env before running:  cp .env.example .env

# --- PostgreSQL (read by the db container) ---
POSTGRES_USER=taskbox
POSTGRES_PASSWORD=taskbox_pass
POSTGRES_DB=taskbox

# --- API (read by the api container) ---
DATABASE_URL=postgresql://taskbox:taskbox_pass@db:5432/taskbox?schema=public
API_PORT=3000
JWT_SECRET=taskbox_secret_key

# Create account at https://cloudinary.com, then copy the three values from
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=
